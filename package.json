{
	"name": "deck-kit",
	"version": "1.0.0",
	"description": "Training-platform compatible Reveal.js deck template (Cyberpunk CRT, whiteboard, live session bridge).",
	"private": false,
	"revealVersion": "6.0.1",
	"deck": {
		"id": "example-deck",
		"title": "Example Deck",
		"course": "",
		"copyright": "MIT \u2014 see LICENSE"
	},
	"homepage": "https://github.com/nalhilal/deck-kit",
	"license": "MIT",
	"main": "dist/reveal.js",
	"module": "dist/reveal.mjs",
	"types": "dist/reveal.d.ts",
	"type": "module",
	"files": [
		"dist",
		"css",
		"js",
		"LICENSE",
		"COPYRIGHT.md",
		"LICENSE-REVEAL.md",
		"README.md",
		"index.html"
	],
	"exports": {
		".": {
			"types": "./dist/reveal.d.ts",
			"import": "./dist/reveal.mjs",
			"require": "./dist/reveal.js",
			"default": "./dist/reveal.js"
		},
		"./reveal.css": "./dist/reveal.css",
		"./reset.css": "./dist/reset.css",
		"./theme/*": "./dist/theme/*",
		"./plugin/highlight/monokai.css": "./dist/plugin/highlight/monokai.css",
		"./plugin/highlight": {
			"types": "./dist/plugin/highlight.d.ts",
			"import": "./dist/plugin/highlight.mjs",
			"require": "./dist/plugin/highlight.js",
			"default": "./dist/plugin/highlight.js"
		},
		"./plugin/markdown": {
			"types": "./dist/plugin/markdown.d.ts",
			"import": "./dist/plugin/markdown.mjs",
			"require": "./dist/plugin/markdown.js",
			"default": "./dist/plugin/markdown.js"
		},
		"./plugin/math": {
			"types": "./dist/plugin/math.d.ts",
			"import": "./dist/plugin/math.mjs",
			"require": "./dist/plugin/math.js",
			"default": "./dist/plugin/math.js"
		},
		"./plugin/notes": {
			"types": "./dist/plugin/notes.d.ts",
			"import": "./dist/plugin/notes.mjs",
			"require": "./dist/plugin/notes.js",
			"default": "./dist/plugin/notes.js"
		},
		"./plugin/search": {
			"types": "./dist/plugin/search.d.ts",
			"import": "./dist/plugin/search.mjs",
			"require": "./dist/plugin/search.js",
			"default": "./dist/plugin/search.js"
		},
		"./plugin/zoom": {
			"types": "./dist/plugin/zoom.d.ts",
			"import": "./dist/plugin/zoom.mjs",
			"require": "./dist/plugin/zoom.js",
			"default": "./dist/plugin/zoom.js"
		}
	},
	"scripts": {
		"version:patch": "npm version patch --no-git-tag-version",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version",
		"prestart": "node scripts/inject-deck-meta.mjs",
		"dev": "npm run start",
		"start": "vite",
		"prepack": "npm run build",
		"build:core": "tsc && vite build && vite build -c vite.config.styles.ts && node scripts/add-banner.js dist/reveal.js",
		"build:es5": "npm run build && node scripts/build-es5.js",
		"build:styles": "vite build -c vite.config.styles.ts",
		"build:whiteboard": "vite build -c vite.config.whiteboard.ts && node scripts/copy-excalidraw-assets.js",
		"vendor:tldreveal": "node scripts/vendor-tldreveal.js",
		"build:present": "npm run build:whiteboard && npm run vendor:tldreveal",
		"build": "tsc && vite build && vite build -c vite.config.styles.ts && vite build -c plugin/highlight/vite.config.ts && vite build -c plugin/markdown/vite.config.ts && vite build -c plugin/math/vite.config.ts && vite build -c plugin/notes/vite.config.ts && vite build -c plugin/search/vite.config.ts && vite build -c plugin/zoom/vite.config.ts && node scripts/add-banner.js dist/reveal.js",
		"package": "node scripts/zip.js",
		"package:platform": "cp node_modules/marked/lib/marked.umd.js plugin/notes/marked.umd.js && vite build -c plugin/notes/vite.config.ts && node scripts/package-deck.mjs && node scripts/verify-platform-bundle.mjs",
		"verify:platform-bundle": "node scripts/verify-platform-bundle.mjs",
		"test:poll-markers": "node --test scripts/scan-poll-markers.test.mjs",
		"test:deck-meta": "node --test scripts/inject-deck-meta.test.mjs",
		"test:board-markers": "node --test scripts/scan-board-markers.test.mjs",
		"test:position-utils": "node --test scripts/platform-position-utils.test.mjs",
		"test:whiteboard-limits": "node --test scripts/platform-bridge-whiteboard.limits.test.mjs",
		"test": "node scripts/test.js",
		"init": "node scripts/init-deck.mjs",
		"test:init-deck": "node --test scripts/init-deck.test.mjs",
		"test:deck-content": "node --test scripts/deck-content.test.mjs"
	},
	"author": "Nasser Ahmad",
	"contributors": [
		{
			"name": "Hakim El Hattab",
			"role": "Reveal.js upstream"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nalhilal/deck-kit.git"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=20.19.0",
			"onFail": "error"
		}
	},
	"keywords": [
		"reveal.js",
		"presentation",
		"ai-literacy",
		"training",
		"excalidraw",
		"whiteboard",
		"tldreveal",
		"cyberpunk-2077",
		"facilitator-deck"
	],
	"dependencies": {
		"@excalidraw/excalidraw": "^0.18.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tldreveal": "^1.2.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"esbuild": "^0.28.1",
		"fitty": "^2.4.2",
		"glob": "^13.0.6",
		"highlight.js": "^11.11.1",
		"jszip": "^3.10.1",
		"marked": "^17.0.5",
		"marked-smartypants": "^1.1.11",
		"node-qunit-puppeteer": "^2.2.1",
		"qunit": "^2.25.0",
		"sass": "^1.98.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.5",
		"vite-plugin-dts": "^4.5.4"
	},
	"overrides": {
		"@microsoft/api-extractor": {
			"minimatch": "10.2.4"
		},
		"lodash-es": "^4.18.0",
		"nanoid@3": "3.3.12",
		"nanoid@4": "5.0.9"
	}
}
